<Window
    x:Class="GitSync.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GitSync.App.Views">

    <Grid x:Name="Root" Background="{ThemeResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <views:RailView x:Name="Rail" />

        <Grid x:Name="Repository" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <views:TopBarView x:Name="TopBar" />
            <Grid x:Name="Panels" Grid.Row="1" Margin="0,0,10,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="5*" MinWidth="320" />
                    <ColumnDefinition Width="6*" MinWidth="340" />
                </Grid.ColumnDefinitions>
                <views:SidebarView x:Name="Sidebar" />
                <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <views:HistoryView x:Name="History" />
                        <views:ChangesView x:Name="Changes" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <views:CommitDetailView x:Name="Detail" />
                        <views:DiffView x:Name="Diff" Grid.Row="1" />
                        <TextBlock x:Name="NoCommit" Grid.RowSpan="2" Text="Select a commit to see its changes"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="Home" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="HomeDragArea" Background="Transparent" Margin="0,0,140,0" />
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <TextBlock Text="GitSync" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="Open a Git repository to get started" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Open repository" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                        Click="OnOpen" />
            </StackPanel>
        </Grid>

        <ProgressRing x:Name="Loading" Grid.Column="1" Width="40" Height="40" IsActive="False" />
        <Border x:Name="BusyPill" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                CornerRadius="18" Padding="16,8" Background="{ThemeResource PanelBrush}"
                BorderBrush="{ThemeResource PillBorderBrush}" BorderThickness="1" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing x:Name="Busy" Width="16" Height="16" />
                <TextBlock x:Name="BusyText" />
            </StackPanel>
        </Border>
        <InfoBar x:Name="Error" Grid.Column="1" VerticalAlignment="Bottom" Margin="16" Severity="Error" IsOpen="False"
                 Title="Something went wrong" Closed="OnErrorClosed" Background="{ThemeResource PanelBrush}">
            <!-- Git output can run to many lines, so the message scrolls instead of growing the banner. -->
            <ScrollViewer x:Name="ErrorScroller" MaxHeight="160" Margin="0,0,0,12" Padding="0,0,12,0">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </InfoBar>
        <views:SettingsView x:Name="Settings" Grid.ColumnSpan="2" Visibility="Collapsed" />
        <views:CommandPaletteView x:Name="CommandPalette" Grid.ColumnSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
