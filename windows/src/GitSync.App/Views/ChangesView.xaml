<UserControl
    x:Class="GitSync.App.Views.ChangesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GitSync.App.Views">

    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView x:Name="Files" Padding="4" SelectionChanged="OnSelected" ContainerContentChanging="OnRow"
                      ContextRequested="OnContext">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <views:FileRowView />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="Clean" Text="Working tree is clean" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Row="1" Margin="12" Spacing="8">
                <TextBox x:Name="Message" PlaceholderText="Commit message" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="90" TextChanged="OnMessageChanged" />
                <Grid>
                    <CheckBox x:Name="Amend" Content="Amend last commit" Click="OnAmend" />
                    <Button x:Name="CommitButton" Content="Commit" HorizontalAlignment="Right"
                            Style="{StaticResource AccentButtonStyle}" Click="OnCommit" />
                </Grid>
            </StackPanel>
    </Grid>
</UserControl>
