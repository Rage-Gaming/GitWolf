<UserControl
    x:Class="GitSync.App.Views.FileRowView"
    xmlns:views="using:GitSync.App.Views"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Height="32" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="19" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Badge" Width="19" Height="19" CornerRadius="6" VerticalAlignment="Center">
            <TextBlock x:Name="Kind" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Grid Grid.Column="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:FileIconView x:Name="TypeIcon" />
            <TextBlock x:Name="NameText" Grid.Column="1" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            <views:FileIconView x:Name="FolderIcon" Grid.Column="2" Width="13" Height="13" />
            <TextBlock x:Name="PathText" Grid.Column="3" FontSize="11.5" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </Grid>
        <TextBlock x:Name="Header" Grid.ColumnSpan="2" VerticalAlignment="Center" FontSize="11"
                   FontWeight="SemiBold" CharacterSpacing="60"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Border x:Name="Lfs" Grid.Column="2" CornerRadius="6" Padding="5,1" VerticalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed"
                ToolTipService.ToolTip="Stored with Git LFS">
            <TextBlock Text="LFS" FontSize="9.5" FontWeight="Bold" />
        </Border>
        <Button x:Name="Action" Grid.Column="3" Height="26" Padding="10,0" FontSize="12"
                VerticalAlignment="Center" Click="OnAction" />
    </Grid>
</UserControl>
