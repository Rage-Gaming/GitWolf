<UserControl
    x:Class="GitSync.App.Views.SidebarRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Height="30" ColumnSpacing="8" Background="Transparent">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ContentPresenter x:Name="DrawnIcon" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border x:Name="CurrentMark" Width="9" Height="9" CornerRadius="4.5" Background="#2EA043"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,-3,0" Visibility="Collapsed">
            <FontIcon Glyph="&#xE73E;" FontSize="6" Foreground="White" />
        </Border>
        <TextBlock x:Name="Label" Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <StackPanel x:Name="HeaderPanel" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock x:Name="Header" FontSize="11.5" FontWeight="SemiBold" CharacterSpacing="60"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <Border CornerRadius="8" Padding="6,0" Background="{ThemeResource PillFillBrush}">
                <TextBlock x:Name="Count" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </StackPanel>
        <TextBlock x:Name="Trailing" Grid.Column="2" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{ThemeResource AccentLabelBrush}" />
        <FontIcon x:Name="Chevron" Grid.Column="2" FontSize="10" VerticalAlignment="Center" Glyph="&#xE76C;"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
            <FontIcon.RenderTransform>
                <RotateTransform x:Name="ChevronTurn" />
            </FontIcon.RenderTransform>
        </FontIcon>
    </Grid>
</UserControl>
