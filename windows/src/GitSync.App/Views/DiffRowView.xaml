<UserControl
    x:Class="GitSync.App.Views.DiffRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Height="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Old" FontFamily="Consolas" FontSize="12" HorizontalTextAlignment="Right"
                   Padding="0,2,8,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        <TextBlock x:Name="New" Grid.Column="1" FontFamily="Consolas" FontSize="12" HorizontalTextAlignment="Right"
                   Padding="0,2,8,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        <TextBlock x:Name="Code" Grid.Column="2" FontFamily="Consolas" FontSize="13" Padding="4,2,0,0"
                   TextWrapping="NoWrap" />
    </Grid>
</UserControl>
