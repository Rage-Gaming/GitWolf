<Window
    x:Class="GitWolf.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GitWolf.App.Views">

    <Grid x:Name="Root" Background="{ThemeResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <views:RailView x:Name="Rail" />

        <Grid x:Name="Repository" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <views:TopBarView x:Name="TopBar" />
            <StackPanel Grid.Row="1">
                <views:OperationBannerView x:Name="Banner" Margin="0,0,10,8" Visibility="Collapsed" />
                <views:ToolBannersView x:Name="ToolBanners" />
            </StackPanel>
            <Grid x:Name="Panels" Grid.Row="2" Margin="0,0,10,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="248" />
                    <ColumnDefinition x:Name="ListColumn" Width="5*" MinWidth="260" />
                    <ColumnDefinition x:Name="DetailColumn" Width="6*" MinWidth="320" />
                </Grid.ColumnDefinitions>
                <views:SidebarView x:Name="Sidebar" />
                <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <views:HistoryView x:Name="History" />
                        <views:ChangesView x:Name="Changes" />
                        <views:CompareView x:Name="Compare" />
                        <views:StashView x:Name="StashPanel" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <views:CommitDetailView x:Name="Detail" />
                        <views:DiffView x:Name="Diff" Grid.Row="1" />
                        <views:ConflictView x:Name="Conflict" Grid.RowSpan="2" Visibility="Collapsed" />
                        <TextBlock x:Name="NoCommit" Grid.RowSpan="2" Text="Select a commit to see its changes"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
                <views:PanelSplitter x:Name="SidebarSplitter" HorizontalAlignment="Right" Margin="0,0,-11,0" />
                <views:PanelSplitter x:Name="ListSplitter" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,-11,0" />
            </Grid>
        </Grid>

        <Grid x:Name="Home" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="HomeDragArea" Background="Transparent" Margin="0,0,140,0" />
            <views:DashboardView x:Name="Dashboard" Grid.Row="1" />
        </Grid>

        <ProgressRing x:Name="Loading" Grid.Column="1" Width="40" Height="40" IsActive="False" />
        <!-- Short notices above the progress pill, at the bottom of the window. -->
        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"
                    Spacing="8" IsHitTestVisible="False">
            <StackPanel.Resources>
                <Storyboard x:Name="NoticeAnimation">
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NoticePill" Storyboard.TargetProperty="Opacity">
                        <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="1" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </StackPanel.Resources>
            <Border x:Name="NoticePill" HorizontalAlignment="Center" Opacity="0"
                    CornerRadius="18" Padding="16,8" Background="{ThemeResource PanelBrush}"
                    BorderBrush="{ThemeResource PillBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="NoticeText" />
                </StackPanel>
            </Border>
            <Border x:Name="BusyPill" HorizontalAlignment="Center"
                    CornerRadius="18" Padding="16,8" Background="{ThemeResource PanelBrush}"
                    BorderBrush="{ThemeResource PillBorderBrush}" BorderThickness="1" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing x:Name="Busy" Width="16" Height="16" />
                    <TextBlock x:Name="BusyText" />
                </StackPanel>
            </Border>
        </StackPanel>
        <InfoBar x:Name="Error" Grid.Column="1" VerticalAlignment="Bottom" Margin="16" Severity="Error" IsOpen="False"
                 Title="Something went wrong" Closed="OnErrorClosed" Background="{ThemeResource PanelBrush}">
            <!-- Git output can run to many lines, so the message scrolls instead of growing the banner. -->
            <ScrollViewer x:Name="ErrorScroller" MaxHeight="160" Margin="0,0,0,12" Padding="0,0,12,0">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </InfoBar>
        <views:SettingsView x:Name="Settings" Grid.ColumnSpan="2" Visibility="Collapsed" />
        <views:CommandPaletteView x:Name="CommandPalette" Grid.ColumnSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
